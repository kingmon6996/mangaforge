APP_SECRET_KEY=replace-with-a-long-random-secret
APP_HOST=127.0.0.1
APP_PORT=5000

SUPABASE_DB_HOST=your-project.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-reference
SUPABASE_DB_PASSWORD=replace-with-your-database-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-account@example.com
SMTP_PASSWORD=replace-with-your-smtp-app-password
